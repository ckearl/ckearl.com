# SHA-256 hex of the page password. See scripts/deploy.sh.
BRIEF_PASSWORD_HASH=
# Signs login tokens. Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
BRIEF_TOKEN_SECRET=
# The spotify_stats stack's DashboardBucket, for the listening snapshot.
SPOTIFY_BUCKET=
# Copied from spotify_stats/.env, for discographies and new releases. Without them the
# soundtrack only suggests albums back in rotation.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Score highlights. Filled in by scripts/connect_youtube.py.
YOUTUBE_API_KEY=
# Filled in by scripts/connect_google.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# SHA-256 hex of the iPhone Shortcut's key. The key itself goes in .todos-key.
TODOS_KEY_HASH=
# Calendars that aren't mine, as comma-separated id=hers, id=shared or id=skip.
CALENDAR_OWNERS=
# Garmin Connect, Settings, Personal API.
GARMIN_API_KEY=
# Training settings, kept out of the repo.
TRAINING_EASY_PACE=
TRAINING_BASE_MILES=
# Usual work hours, used because the work calendar can't be read.
WORK_HOURS=Mon-Fri,08:00-17:00
# The morning stretch spent helping get out the door. Use the longest it usually takes.
MORNING_HELP=Mon-Fri,07:00-07:40
